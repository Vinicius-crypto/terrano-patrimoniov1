POSTGRES_USER=patrimonio
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=patrimonio

# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Local (fora do Docker); no Docker o compose monta a URL a partir das variáveis POSTGRES_*.
DATABASE_URL=postgresql://patrimonio:troque-esta-senha@localhost:5432/patrimonio

FLASK_ENV=development
FLASK_DEBUG=1

# Use 1 somente atrás de HTTPS.
SESSION_COOKIE_SECURE=0
